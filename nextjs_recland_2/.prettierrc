{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "plugins": [
    "prettier-plugin-tailwindcss",
    "prettier-plugin-classnames",
    "prettier-plugin-merge"
  ],
  "tailwindFunctions": ["clsx", "twMerge"],
  "classNames": ["baseStyle", "className"],
  "customAttributes": ["baseStyle", "className"],
  "syntaxTransformation": true
}
